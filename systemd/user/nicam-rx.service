[Unit]
Description=NICAM receiver via rtl_sdr (websdr, 436 MHz IF)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/nicam
ExecStart=%h/nicam/systemd/user/nicam-rx.sh
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1
Environment=NICAM_ENV=websdr
# Optional:
# Environment=NICAM_ENV_FILE=%h/nicam/config/environments/websdr.env

[Install]
WantedBy=default.target
