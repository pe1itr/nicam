#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
ENV_NAME="${NICAM_ENV:-$(hostname -s)}"
ENV_FILE="${NICAM_ENV_FILE:-${REPO_DIR}/config/environments/${ENV_NAME}.env}"

if [[ -f "${ENV_FILE}" ]]; then
  # shellcheck disable=SC1090
  source "${ENV_FILE}"
fi

PYTHON_MODE="${PYTHON_MODE:-src}"
PYTHON_BIN="${PYTHON_BIN:-python3}"
VENV_PATH="${VENV_PATH:-${REPO_DIR}/.venv}"
AUDIO_BACKEND="${AUDIO_BACKEND:-stdout}"
AUDIO_DEVICE="${AUDIO_DEVICE:-default}"
AUDIO_BUFFER_TIME="${AUDIO_BUFFER_TIME:-}"
AUDIO_PERIOD_TIME="${AUDIO_PERIOD_TIME:-}"
NICAM_RX_STATUS_JSON="${NICAM_RX_STATUS_JSON:-}"
NICAM_RX_STATUS_EVERY="${NICAM_RX_STATUS_EVERY:-1000}"

if [[ "${PYTHON_MODE}" == "venv" ]]; then
  if [[ ! -x "${VENV_PATH}/bin/python" && -n "${VIRTUAL_ENV:-}" && -x "${VIRTUAL_ENV}/bin/python" ]]; then
    echo "VENV_PATH ${VENV_PATH} niet gevonden; gebruik actieve venv ${VIRTUAL_ENV}" >&2
    VENV_PATH="${VIRTUAL_ENV}"
  elif [[ ! -x "${VENV_PATH}/bin/python" && -x "${REPO_DIR}/.venv/bin/python" ]]; then
    echo "VENV_PATH ${VENV_PATH} niet gevonden; gebruik ${REPO_DIR}/.venv" >&2
    VENV_PATH="${REPO_DIR}/.venv"
  fi
  PYTHON_BIN="${VENV_PATH}/bin/python"
elif [[ "${PYTHON_MODE}" == "user" ]]; then
  PYTHON_BIN="${PYTHON_BIN:-python3}"
elif [[ "${PYTHON_MODE}" != "src" ]]; then
  echo "Onbekende PYTHON_MODE=${PYTHON_MODE}; gebruik src, user of venv." >&2
  exit 2
fi

if [[ "${PYTHON_BIN}" == */* ]]; then
  if [[ ! -x "${PYTHON_BIN}" ]]; then
    echo "Python niet uitvoerbaar: ${PYTHON_BIN}" >&2
    exit 2
  fi
elif ! command -v "${PYTHON_BIN}" >/dev/null 2>&1; then
  echo "Python niet gevonden in PATH: ${PYTHON_BIN}" >&2
  exit 2
fi

run_python() {
  if [[ "${PYTHON_MODE}" == "src" ]]; then
    PYTHONPATH="${REPO_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}" "${PYTHON_BIN}" "$@"
  else
    "${PYTHON_BIN}" "$@"
  fi
}

audio_player() {
  local rate="$1"
  case "${AUDIO_BACKEND}" in
    stdout)
      cat
      ;;
    ffplay)
      ffplay -hide_banner -loglevel error -nodisp \
        -f s16le -sample_rate "${rate}" -ch_layout stereo -i -
      ;;
    aplay)
      local aplay_args=(-q -f S16_LE -r "${rate}" -c 2 -D "${AUDIO_DEVICE}")
      if [[ -n "${AUDIO_BUFFER_TIME}" ]]; then
        aplay_args+=(--buffer-time="${AUDIO_BUFFER_TIME}")
      fi
      if [[ -n "${AUDIO_PERIOD_TIME}" ]]; then
        aplay_args+=(--period-time="${AUDIO_PERIOD_TIME}")
      fi
      aplay "${aplay_args[@]}"
      ;;
    none)
      cat >/dev/null
      ;;
    *)
      echo "Onbekende AUDIO_BACKEND=${AUDIO_BACKEND}; gebruik stdout, ffplay, aplay of none." >&2
      exit 2
      ;;
  esac
}

usage() {
  cat >&2 <<'EOF'
Gebruik:
  tools/nicam-run nicam-rx [rtl_sdr opties] [./nicam-rx opties]
  tools/nicam-run wbfm-rx [extra wbfm_rx.rtl_rx opties]
  tools/nicam-run wbfm-tx [extra wbfm_tx.main opties]
  tools/nicam-run module <python.module> [args...]

Profielkeuze:
  NICAM_ENV=<naam> gebruikt config/environments/<naam>.env
  NICAM_ENV_FILE=/pad/naar/profiel.env gebruikt expliciet profielbestand
EOF
}

run_nicam_rx() {
  local device_index=0
  local freq=""
  local sample_rate="${NICAM_RX_SAMPLE_RATE:-1456000}"
  local ppm=0
  local gain=auto
  local iq_in="-"
  local iq_format=u8
  local verbose=0
  local matched_filter=0
  local matched_rolloff=0.4
  local matched_span_symbols=6
  local nicam_extra=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --device-index)
        device_index="$2"; shift 2 ;;
      --freq)
        freq="$2"; shift 2 ;;
      --sample-rate)
        sample_rate="$2"; shift 2 ;;
      --ppm)
        ppm="$2"; shift 2 ;;
      --gain)
        gain="$2"; shift 2 ;;
      --iq-in)
        iq_in="$2"; shift 2 ;;
      --iq-format)
        iq_format="$2"; shift 2 ;;
      --matched-filter)
        matched_filter=1; shift ;;
      --matched-rolloff)
        matched_rolloff="$2"; shift 2 ;;
      --matched-span-symbols)
        matched_span_symbols="$2"; shift 2 ;;
      --adaptive-fixed|--bitstream-quality|--matched-filter|--allow-unsupported-modes)
        nicam_extra+=("$1"); shift ;;
      --timing-search-steps|--chunk-bytes|--carrier-search-hz|--carrier-search-step-hz|--conceal-mode|--stats-every|--stats-json|--frontend-lowpass-hz|--adaptive-costas-alpha|--adaptive-gain-mu|--adaptive-omega-relative-limit|--ram-read-start|--ram-read-stride|--max-parity-errors|--max-pcm-step|--lock-max-parity-errors|--lock-confirm-frames|--lock-drop-frames|--max-bad-frames|--conceal-bad-frames|--scramble-phase)
        nicam_extra+=("$1" "$2"); shift 2 ;;
      --verbose)
        verbose=1; shift ;;
      --help|-h)
        "${REPO_DIR}/nicam-rx" --help
        return 0 ;;
      *)
        echo "Onbekende nicam-rx optie voor C decoder: $1" >&2
        return 2 ;;
    esac
  done

  local nicam_args=(
    --sample-rate "${sample_rate}"
    --iq-format "${iq_format}"
  )
  if [[ "${matched_filter}" != "0" ]]; then
    nicam_args+=(
      --matched-filter
      --matched-rolloff "${matched_rolloff}"
      --matched-span-symbols "${matched_span_symbols}"
    )
  fi
  if [[ "${verbose}" != "0" ]]; then
    nicam_args+=(--verbose)
  fi
  if [[ -n "${NICAM_RX_STATUS_JSON}" ]]; then
    mkdir -p "$(dirname -- "${NICAM_RX_STATUS_JSON}")"
    nicam_args+=(--stats-json "${NICAM_RX_STATUS_JSON}")
    if [[ "${NICAM_RX_STATUS_EVERY}" != "0" ]]; then
      nicam_args+=(--stats-every "${NICAM_RX_STATUS_EVERY}")
    fi
  fi
  nicam_args+=("${nicam_extra[@]}")

  if [[ -n "${freq}" ]]; then
    local rtl_args=(
      rtl_sdr
      -d "${device_index}"
      -f "${freq}"
      -s "${sample_rate}"
      -p "${ppm}"
      -
    )
    if [[ "${gain}" != "auto" ]]; then
      rtl_args=(rtl_sdr -g "${gain}" -d "${device_index}" -f "${freq}" -s "${sample_rate}" -p "${ppm}" -)
    fi
    "${rtl_args[@]}" | "${REPO_DIR}/nicam-rx" "${nicam_args[@]}" | audio_player "${NICAM_AUDIO_RATE:-32000}"
  else
    if [[ "${iq_in}" == "-" ]]; then
      "${REPO_DIR}/nicam-rx" "${nicam_args[@]}" | audio_player "${NICAM_AUDIO_RATE:-32000}"
    else
      "${REPO_DIR}/nicam-rx" "${nicam_args[@]}" < "${iq_in}" | audio_player "${NICAM_AUDIO_RATE:-32000}"
    fi
  fi
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

cmd="$1"
shift
cd "${REPO_DIR}"

case "${cmd}" in
  nicam-rx)
    run_nicam_rx "$@"
    ;;
  wbfm-rx)
    run_python -m wbfm_rx.rtl_rx "$@" --audio-out - | audio_player "${WBFM_AUDIO_RATE:-48000}"
    ;;
  wbfm-tx)
    run_python -m wbfm_tx.main "$@"
    ;;
  module)
    if [[ $# -lt 1 ]]; then
      usage
      exit 2
    fi
    module="$1"
    shift
    run_python -m "${module}" "$@"
    ;;
  *)
    usage
    exit 2
    ;;
esac
