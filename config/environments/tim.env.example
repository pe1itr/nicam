# Copy to tim.env on the FM transmitter host whose hostname is tim.

: "${PYTHON_MODE:=venv}"
: "${PYTHON_BIN:=python3}"
: "${VENV_PATH:=${REPO_DIR}/.venv}"

: "${AUDIO_BACKEND:=ffplay}"
: "${AUDIO_DEVICE:=default}"

: "${NICAM_AUDIO_RATE:=32000}"
: "${WBFM_AUDIO_RATE:=48000}"

# Defaults used by tools/tim-wbfm-tx unless overridden in the shell.
: "${TX_FREQ_MHZ:=2324}"
: "${TX_GAIN_DB:=-10}"
: "${TX_SOURCE:=stream}"
: "${TX_STREAM_URL:=https://icecast.omroep.nl/radio2-bb-aac}"
: "${TX_AUDIO_FILE:=}"
: "${TX_AUDIO_DEVICE:=}"
: "${TX_UDP_URL:=udp://0.0.0.0:7355}"

# Defaults used by tools/tim-nicam-tx unless overridden in the shell.
: "${NICAM_TX_LO_HZ:=2324000000}"
: "${NICAM_TX_GAIN_DB:=-10}"
: "${NICAM_TX_CONNECT_MODE:=network}"
: "${NICAM_TX_IP:=192.168.2.1}"
: "${NICAM_TX_USB_URI:=usb:}"
: "${NICAM_BASEBAND_SAMPLE_RATE:=1456000}"
# Leave unset for auto-detect. Old Pluto firmware can keep 1456000; OpenSourceSDRLab
# Pluto-compatible firmware will auto-select 3840000 from sampling_frequency_available.
: "${NICAM_TX_DEVICE_SAMPLE_RATE:=${NICAM_TX_SAMPLE_RATE:-}}"
: "${NICAM_TX_RF_BANDWIDTH:=750000}"
# NICAM baseband carrier level, compatible with Digital Baseband rf_level 0..1023.
: "${NICAM_TX_RF_LEVEL:=200}"
# Final Pluto DAC scale.
: "${NICAM_TX_AMPLITUDE:=0.8}"
: "${NICAM_TX_SOURCE:=stream}"
: "${NICAM_TX_STREAM_URL:=https://icecast.omroep.nl/radio2-bb-aac}"
: "${NICAM_TX_AUDIO_FILE:=}"
: "${NICAM_TX_UDP_URL:=udp://0.0.0.0:7355}"
: "${NICAM_TX_PULSE_SHAPE:=1}"
: "${NICAM_TX_PULSE_ROLLOFF:=0.4}"
: "${NICAM_TX_PULSE_SPAN_SYMBOLS:=6}"
# Optional Digital Baseband V1.4-compatible NICAM station ID, first 8 ASCII chars.
: "${NICAM_TX_STATION_ID:=}"
