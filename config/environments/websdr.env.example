# Copy to websdr.env on the Odroid whose hostname is websdr.

# src: run from checkout with PYTHONPATH=src
# user: use installed console/module packages from python --user
# venv: use VENV_PATH/bin/python
: "${PYTHON_MODE:=src}"
: "${PYTHON_BIN:=python3}"
: "${VENV_PATH:=${REPO_DIR}/.venv}"

# stdout: leave raw s16le on stdout
# ffplay: play raw PCM through ffplay
# aplay: play raw PCM through ALSA device in AUDIO_DEVICE
# none: discard audio
: "${AUDIO_BACKEND:=aplay}"
: "${AUDIO_DEVICE:=plughw:0,0}"
: "${AUDIO_BUFFER_TIME:=2000000}"
: "${AUDIO_PERIOD_TIME:=200000}"

: "${NICAM_AUDIO_RATE:=32000}"
: "${WBFM_AUDIO_RATE:=48000}"

# Defaults used by tools/websdr-wbfm-rx unless overridden in the shell.
: "${DEVICE_INDEX:=1}"
: "${FREQ_HZ:=436000000}"
: "${SAMPLE_RATE:=960000}"
: "${GAIN:=auto}"
: "${PPM:=0}"

# Defaults used by tools/websdr-nicam-rx unless overridden in the shell.
: "${NICAM_RX_FREQ_HZ:=436000000}"
: "${NICAM_RX_SAMPLE_RATE:=1456000}"
: "${NICAM_RX_DEVICE_INDEX:=2}"
: "${NICAM_RX_GAIN:=33}"
: "${NICAM_RX_PPM:=0}"
: "${NICAM_RX_MATCHED_FILTER:=0}"
: "${NICAM_RX_MATCHED_ROLLOFF:=0.4}"
: "${NICAM_RX_MATCHED_SPAN_SYMBOLS:=6}"
: "${NICAM_RX_EXTRA_ARGS:=--adaptive-fixed --timing-search-steps 16 --chunk-bytes 32768 --carrier-search-hz 30000 --carrier-search-step-hz 1000 --conceal-mode bridge --stats-every 1000}"
